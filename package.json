{
  "name": "flip-clock",
  "version": "1.0.0",
  "description": "Minimal Floating Flip Clock for Windows",
  "author": "Flip Clock",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "vite build",
    "build:electron": "electron-builder --win",
    "pack": "electron-builder --win --dir",
    "build": "npm run build:vite && npm run build:electron",
    "start": "electron ."
  },
  "build": {
    "appId": "com.flipclock.minimal",
    "productName": "FlipClock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flip Clock"
    }
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
